{
  "name": "@ltv/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch --env-file-if-exists=../.env src/main.ts",
    "start": "node --env-file-if-exists=../.env dist/main.js",
    "test": "vitest run",
    "dao:new": "node scripts/new-dao.mjs",
    "seed:demo": "tsx --env-file-if-exists=../.env scripts/seed-demo.ts",
    "e2e:admin:create": "tsx --env-file-if-exists=../.env scripts/admin-e2e-fixture.ts create",
    "e2e:admin:cleanup": "tsx --env-file-if-exists=../.env scripts/admin-e2e-fixture.ts cleanup",
    "seed:lab": "tsx --env-file-if-exists=../.env scripts/seed-lab-products.ts",
    "seed:valves": "tsx --env-file-if-exists=../.env scripts/seed-valve-products.ts",
    "test:db": "node --env-file-if-exists=../.env ../node_modules/vitest/vitest.mjs run"
  },
  "dependencies": {
    "@ltv/config": "workspace:*",
    "@ltv/contracts": "workspace:*",
    "@ltv/db": "workspace:*",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@node-rs/argon2": "^2.0.2",
    "express": "^4.21.2",
    "jose": "^5.9.6",
    "kysely": "^0.27.5",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@ltv/testing": "workspace:*",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/pg": "^8.11.10",
    "vitest": "^2.1.8"
  }
}
