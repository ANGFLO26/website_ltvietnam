{
  "name": "@ltv/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "node --env-file-if-exists=../.env --experimental-strip-types --watch src/main.ts",
    "start": "node --env-file-if-exists=../.env dist/main.js",
    "test": "vitest run",
    "dao:new": "node scripts/new-dao.mjs"
  },
  "dependencies": {
    "@ltv/config": "workspace:*",
    "@ltv/contracts": "workspace:*",
    "@ltv/db": "workspace:*",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@node-rs/argon2": "^2.0.2",
    "jose": "^5.9.6",
    "kysely": "^0.27.5",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/pg": "^8.11.10",
    "vitest": "^2.1.8"
  }
}
