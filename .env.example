# ============================================================
# LT Vietnam — bien moi truong. Copy sang .env va dien gia tri.
# KHONG commit file .env.
# ============================================================

NODE_ENV=development
LOG_LEVEL=info

# --- PostgreSQL 16 ---
# Cong tren may chu ma container PostgreSQL gan vao. Doi khi 5432 da bi mot
# ban PostgreSQL cai san chiem — khi do doi CA hai dong duoi day.
POSTGRES_HOST_PORT=5432
DATABASE_URL=postgresql://ltv:ltv_dev_password@localhost:5432/ltvn_dev
DATABASE_SCHEMA=ltv
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=10000

# --- Nest Core API ---
API_PORT=3001
API_BASE_PATH=/api/v1
# CORS: danh sach origin cu the, khong dung *
CORS_ORIGINS=http://localhost:3000,http://localhost:3002

# --- Auth (ADR/A19) ---
# Sinh bang: openssl rand -base64 48
JWT_SECRET=thay-bang-gia-tri-that-truoc-khi-chay
JWT_TTL_HOURS=8
PASSWORD_RESET_SECRET=thay-bang-gia-tri-that-truoc-khi-chay
PASSWORD_RESET_TTL_MINUTES=30
COOKIE_NAME=ltv_session
# MAC DINH la `true`. Chi dat `false` khi chay tren http://localhost —
# tren production `assertProductionSafe()` se TU CHOI khoi dong neu la false.
COOKIE_SECURE=false
CSRF_COOKIE_NAME=ltv_csrf
CSRF_HEADER_NAME=x-csrf-token
MIN_PASSWORD_LENGTH=12
# Chi bat khi that su dung sau reverse proxy (nginx/Caddy/CDN).
TRUST_PROXY=false
# Tran so lan bam Argon2 cung luc. Moi lan ton ~19 MiB.
HASH_MAX_CONCURRENT=4
HASH_MAX_QUEUED=32
COOKIE_SAME_SITE=strict
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_MINUTES=15
LOGIN_LOCK_AFTER_ATTEMPTS=10

# --- Next.js ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
ADMIN_SITE_URL=http://localhost:3002
# Next goi Nest qua mang noi bo
INTERNAL_API_URL=http://localhost:3001/api/v1
API_TIMEOUT_MS=8000
RESOLVER_CEILING_MS=350
# Chuỗi fallback ảnh Open Graph: featured → cover → logo → ảnh mặc định.
# Để trống một nấc nếu chưa có tài sản đã xuất bản; không phát URL ảnh hỏng.
SEO_SITE_COVER_IMAGE_URL=
SEO_SITE_LOGO_URL=
SEO_DEFAULT_SOCIAL_IMAGE_URL=

# --- Media (D20 / ADR-005) ---
MEDIA_ROOT=./.data/media
MEDIA_PUBLIC_DIR=public-media
MEDIA_PROTECTED_DIR=protected-documents
MEDIA_TEMP_DIR=.tmp
MEDIA_QUARANTINE_DIR=.quarantine
MEDIA_MAX_UPLOAD_BYTES=20971520
MEDIA_PURGE_DELAY_DAYS=30
MEDIA_PUBLIC_MAX_AGE_SECONDS=86400

# --- Worker outbox (ADR-003 / D6) ---
WORKER_ID=worker-local-1
WORKER_BATCH_SIZE=10
WORKER_POLL_INTERVAL_MS=5000
WORKER_PROCESSING_TIMEOUT_MS=300000
WORKER_HEARTBEAT_INTERVAL_MS=15000
WORKER_MAX_ATTEMPTS=5

# --- Email (local ghi tệp; production bat buoc smtp) ---
EMAIL_TRANSPORT=file
EMAIL_FILE_DIR=./.data/mail-outbox
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@ltvietnam.com.vn
INQUIRY_RECIPIENT=inquiries@ltvietnam.com.vn

# Local khong cau hinh: form chi chap nhan token `dev-bypass`.
# Production bat buoc `turnstile` hoac `recaptcha` va secret that.
CAPTCHA_PROVIDER=
CAPTCHA_SECRET=

# Frontend phai dung cung provider; site key la khoa cong khai cua widget.
NEXT_PUBLIC_CAPTCHA_PROVIDER=
NEXT_PUBLIC_CAPTCHA_SITE_KEY=
