{
  "name": "@ltv/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "migrate": "pnpm build && node dist/src/cli.js up",
    "rollback": "pnpm build && node dist/src/cli.js down",
    "status": "pnpm build && node dist/src/cli.js status",
    "verify": "pnpm build && node dist/src/cli.js verify",
    "gen:types": "pnpm build && node dist/scripts/generate-types.js",
    "seed": "pnpm build && node dist/scripts/seed.js"
  },
  "dependencies": {
    "@ltv/config": "workspace:*",
    "kysely": "^0.27.5",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "vitest": "^2.1.8"
  }
}
