# Windows PowerShell (run in v1.0): Get-Content .\V1_0_FILE_MANIFEST.sha256 | ForEach-Object { if ($_ -match '^([0-9a-f]{64})  (.+)$') { $expected=$Matches[1]; $file=$Matches[2]; $actual=(Get-FileHash -LiteralPath $file -Algorithm SHA256).Hash.ToLowerInvariant(); if ($actual -ne $expected) { throw "SHA-256 mismatch: $file" } } }
